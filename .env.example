# Copy to .env and fill in. NEVER commit real values.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_APPROVED_DAGS=training_pipeline
K8S_APPROVED_NAMESPACE=mlops-agent
K8S_APP_LABEL=app=iris-inference
MLOPS_REPO_ROOT=.
# Any OpenAI-compatible endpoint (default: DeepSeek). Leave LLM_API_KEY empty to use the offline rule-based planner.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
AGENT_LLM=auto            # auto | rules | llm
AGENT_API_KEY=            # if set, clients must send X-API-Key
F1_QUALITY_GATE=0.93
FRESHNESS_POLICY_DAYS=30
